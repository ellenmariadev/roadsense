# Road Sense - local development environment configuration.
# Copy this file to `.env` and adjust values as needed.
# These are fictional local-development credentials only; never use real secrets here.

# Application
NODE_ENV=development
APP_PORT=3000

# PostgreSQL (values must match docker-compose.yml)
POSTGRES_USER=road_sense
POSTGRES_PASSWORD=road_sense
POSTGRES_DB=road_sense
# Host port used to expose PostgreSQL locally (change to avoid conflicts).
POSTGRES_PORT=5433

# Prisma connection string (uses the local docker-compose database).
DATABASE_URL=postgresql://road_sense:road_sense@localhost:5433/road_sense?schema=public

# Rate limiting (per client IP, in-memory for local/single-instance use).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Authentication (Phase 7). Generate a random secret locally, e.g.:
#   openssl rand -hex 32
# Never commit a real production secret.
JWT_SECRET=replace-with-the-output-of-openssl-rand-hex-32
JWT_EXPIRES_IN=1h

# Fictional users for `npm run prisma:seed`. Set these in your untracked `.env`
# before seeding; passwords are intentionally not stored in the repository.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=

# LLM integration (Phase 4). Defaults to the offline mock provider.
# Set LLM_PROVIDER=openai and provide OPENAI_API_KEY to use a real provider.
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRIES=2
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
